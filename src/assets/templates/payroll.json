{
  "type": "PAYROLL",
  "category": "payroll",
  "method": "ACH",
  "description": "ADP и другие payroll-провайдеры",
  "templateString": "{PROVIDER} DES:PAYROLL ID:{PMT_ID} INDN:{COMPANY_NAME} PAYDATE {PAYDATE}",
  "placeholders": [
    {
      "name": "PROVIDER",
      "source": "contractor",
      "required": true,
      "maxLength": 20,
      "formatter": "uppercase",
      "defaultOptions": [
        "ADP PAYROLL",
        "PAYCHEX",
        "GUSTO"
      ]
    },
    {
      "name": "PMT_ID",
      "source": "generated",
      "generatorType": "pmtId",
      "length": 9,
      "required": true
    },
    {
      "name": "COMPANY_NAME",
      "source": "companyInfo",
      "field": "companyName",
      "required": true,
      "maxLength": 40,
      "formatter": "uppercase"
    },
    {
      "name": "PAYDATE",
      "source": "date",
      "format": "MMDD",
      "required": true
    }
  ],
  "example": "ADP PAYROLL DES:PAYROLL ID:449912837 INDN:ACME TRUCKING LLC PAYDATE 0826"
}