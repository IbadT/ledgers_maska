📋 ЭТАП 8: КОНТРОЛЛЕР И API
8.1 REST API
8.1.1 Создать src/modules/maska/maska.controller.ts:
TypeScript
Copy
@Controller('maska')
export class MaskaController {
  constructor(private readonly maskaService: MaskaService) {}

  @Post('process')
  @HttpCode(200)
  async processTransactions(
    @Body() input: MaskaInputDto
  ): Promise<MaskaOutputDto> {
    return this.maskaService.processTransactions(input);
  }

  @Post('validate')
  @HttpCode(200)
  validateInput(
    @Body() input: MaskaInputDto
  ): { valid: boolean; errors?: string[] } {
    // Эндпоинт для предварительной валидации без обработки
  }
}
